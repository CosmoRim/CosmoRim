				<li MayRequire="Neronix17.OuterRim.FurnitureAndDecor">OuterRim_DoorCorellian</li>
				<li MayRequire="Neronix17.OuterRim.FurnitureAndDecor">OuterRim_DoorTatooine</li>
			</relatedBuildCommands> -->
