<?xml version="1.0" encoding="UTF-8"?>
<Defs>

	<ThingDef ParentName="CosRimTurretBase">
		<defName>CosRim_ImperiumHeavyEmplacement_Flamethrower</defName>
		<label>heavy emplacement (flamer)</label>
		<description>A large automatic blaster turret. It runs on Tibanna and must be kept fueled. It cannot fire at close-up targets, and may explode when damaged.</description>
		<graphicData>
			<texPath>CosmoRim/Buildings/Security/Emplacement_Base</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(6, 6)</drawSize>
		</graphicData>
		<uiIconPath>CosmoRim/Buildings/Security/Emplacement_Flamer_MenuIcon</uiIconPath>
		<size>(5, 5)</size>
		<statBases>
			<MaxHitPoints>500</MaxHitPoints>
			<Flammability>0.3</Flammability>
			<WorkToBuild>22000</WorkToBuild>
			<Mass>120</Mass>
			<Beauty>0</Beauty>
			<ShootingAccuracyTurret>0.96</ShootingAccuracyTurret>
			<!-- like level 8 human shooter -->
		</statBases>
		<costList>
			<Steel>650</Steel>
			<ComponentSpacer>16</ComponentSpacer>
		</costList>
		<building>
			<turretGunDef>CosRim_ImperiumHeavyEmplacement_FlamethrowerGun</turretGunDef>
			<turretBurstCooldownTime>2.5</turretBurstCooldownTime>
			<turretTopDrawSize>6</turretTopDrawSize>
		</building>
		<placeWorkers>
			<li>PlaceWorker_NotUnderRoof</li>
		</placeWorkers>
		<researchPrerequisites>
			<li>CosRim_ImperialHeavyEngineering</li>
		</researchPrerequisites>
		<comps>
			<!-- <li Class="PipeSystem.CompProperties_RefillWithPipes">
				<pipeNet>CosRim_TibannaNetwork</pipeNet>
				<thing>CosRim_Tibanna</thing>
			</li> -->
			<li Class="CompProperties_Explosive">
				<wickTicks>240</wickTicks>
				<explosiveRadius>5.9</explosiveRadius>
				<explosiveDamageType>Bomb</explosiveDamageType>
				<chanceNeverExplodeFromDamage>0.5</chanceNeverExplodeFromDamage>
			</li>
			<li Class="CompProperties_Forbiddable"/>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>600</basePowerConsumption>
				<shortCircuitInRain>false</shortCircuitInRain>
				<transmitsPower>true</transmitsPower>
			</li>
			<li Class="CompProperties_Flickable"/>
			<li Class="CompProperties_Refuelable">
				<fuelLabel>Shots until dry</fuelLabel>
				<fuelGizmoLabel>Chemfuel</fuelGizmoLabel>
				<outOfFuelMessage>Cannot shoot: Needs Chemfuel</outOfFuelMessage>
				<fuelFilter>
					<thingDefs>
						<li>Chemfuel</li>
					</thingDefs>
				</fuelFilter>
				<fuelCapacity>90</fuelCapacity>
				<fuelMultiplier>2</fuelMultiplier>
				<initialFuelPercent>1</initialFuelPercent>
				<autoRefuelPercent>0.5</autoRefuelPercent>
				<showFuelGizmo>true</showFuelGizmo>
				<minimumFueledThreshold>1</minimumFueledThreshold>
				<factorByDifficulty>false</factorByDifficulty>
				<consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
				<fuelIconPath>UI/Overlays/Barrel</fuelIconPath>
			</li>
		</comps>
		<modExtensions>
			<li Class="TabulaRasa.DefModExt_SubcategoryDisplay">
				<subcategories>
					<li>Security</li>
				</subcategories>
			</li>
		</modExtensions>
	</ThingDef>

	<ThingDef ParentName="CosRimBaseWeaponTurret">
		<defName>CosRim_ImperiumHeavyEmplacement_FlamethrowerGun</defName>
		<label>heavy emplacement flamethrower</label>
		<description>A self-loading large-bore cannon designed to attach to a turret.</description>
		<graphicData>
			<texPath>CosmoRim/Buildings/Security/Emplacement_Flamer_Head</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(6, 6)</drawSize>
		</graphicData>
		<statBases>
			<AccuracyTouch>0.25</AccuracyTouch>
			<AccuracyShort>0.65</AccuracyShort>
			<AccuracyMedium>0.60</AccuracyMedium>
			<AccuracyLong>0.45</AccuracyLong>
			<RangedWeapon_Cooldown>4.5</RangedWeapon_Cooldown>
			<DeteriorationRate>0</DeteriorationRate>
			<Mass>40</Mass>
			<Flammability>0</Flammability>
		</statBases>
		<verbs>
			<li>
				<verbClass>VEF.Weapons.Verb_Shoot</verbClass>
				<defaultProjectile>CosRim_ImperiumHeavyEmplacement_FlamethrowerProj</defaultProjectile>
				<warmupTime>0</warmupTime>
				<minRange>6.9</minRange>
				<range>36.9</range>
				<ticksBetweenBurstShots>16</ticksBetweenBurstShots>
				<burstShotCount>1</burstShotCount>
				<soundCast>OuterRim_Shot_FlameProjector</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>12</muzzleFlashScale>
				<consumeFuelPerShot>3</consumeFuelPerShot>
				<requireLineOfSight>true</requireLineOfSight>
				<!-- <forcedMissRadius>1</forcedMissRadius> -->
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
			</li>
		</verbs>
	</ThingDef>

	<VEF.Weapons.ExpandableProjectileDef ParentName="BaseBullet">
		<defName>CosRim_ImperiumHeavyEmplacement_FlamethrowerProj</defName>
		<label>heavy flamer shot</label>
		<thingClass>VEF.Weapons.FlamethrowProjectile</thingClass>
		<graphicData>
			<texPath>CosmoRim/Projectile/Proj_Flamer</texPath>
			<texPathFadeOut>CosmoRim/Projectile/Proj_FlamerFadeOut</texPathFadeOut>
			<shaderType>MoteGlow</shaderType>
		</graphicData>
		<projectile>
			<damageDef>Flame</damageDef>
			<speed>45</speed>
			<damageAmountBase>24</damageAmountBase>
		</projectile>
		<drawOffscreen>true</drawOffscreen>
		<lifeTimeDuration>50</lifeTimeDuration>
		<widthScaleFactor>0.65</widthScaleFactor>
		<heightScaleFactor>1</heightScaleFactor>
		<startingPositionOffset>(0, 0, -3)</startingPositionOffset>
		<totalSizeScale>1.15</totalSizeScale>
		<tickFrameRate>2</tickFrameRate>
		<finalTickFrameRate>5</finalTickFrameRate>
		<tickDamageRate>20</tickDamageRate>
		<dealsDamageOnce>true</dealsDamageOnce>
		<minDistanceToAffect>6</minDistanceToAffect>
	</VEF.Weapons.ExpandableProjectileDef>
	
</Defs>